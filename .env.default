# langfuse-cli — local dev defaults (seeded project)
#
# Prefer `langfuse init`, which keeps the secret key in the operating-system
# credential store. These variables exist for a throwaway local instance and for
# CI, where the secret comes from the provider's secret store; anything written
# here is plaintext on disk.
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_SECRET_KEY=sk-lf-1234567890
LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_BASE_URL=http://localhost:3000
